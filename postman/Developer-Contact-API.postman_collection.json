{
  "info": {
    "name": "Developer Contact API",
    "description": "Requests for the backend developer landing page assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://127.0.0.1:8000" }],
  "item": [
    {
      "name": "Submit contact",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alex Ivanov\",\n  \"phone\": \"+7 999 123-45-67\",\n  \"email\": \"alex@example.com\",\n  \"comment\": \"I would like to discuss a backend project for our team.\"\n}"
        },
        "url": "{{baseUrl}}/api/contact"
      }
    },
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
    },
    {
      "name": "Metrics",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/metrics" }
    },
    {
      "name": "OpenAPI",
      "request": { "method": "GET", "url": "{{baseUrl}}/openapi.json" }
    }
  ]
}
